# Copy to .env.local for local development. No secrets belong in this file.

# ── Database ──────────────────────────────────────────────────────────────────
# Set to a PostgreSQL/Supabase pooler URL to use Postgres. Leave unset to use the
# in-process PGlite (WASM Postgres) file DB under ./.pglite for local dev/tests.
# DATABASE_URL="postgres://user:pass@host:6543/postgres"

# ── Teacher login ─────────────────────────────────────────────────────────────
# Required on Vercel. Use a private PIN/password of at least 4 characters and a separate long,
# random secret (for example: openssl rand -base64 32).
TEACHER_PIN="change-this-private-password"
SESSION_SECRET="replace-with-at-least-32-random-characters"

# ── English speaking conversation ─────────────────────────────────────────────
GEMINI_API_KEY="your-google-ai-api-key"
GEMINI_MODEL="gemini-3.6-flash"
